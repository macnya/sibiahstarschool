# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys.

# --- Google AI (Genkit) -------------------------------------------------
# Used by src/ai/genkit.ts for the admissions AI guide (gemini-2.0-flash).
# Get a key at https://aistudio.google.com/apikey
# The googleAI() plugin checks GEMINI_API_KEY first, then GOOGLE_API_KEY.
# Set whichever one your genkit version expects — or just set both.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Supabase -----------------------------------------------------------
# From your Supabase project: Settings > API
# The anon key is safe to expose to the browser; it is constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely. Must NOT have a NEXT_PUBLIC_ prefix
# and must never be referenced from a client component.
SUPABASE_SERVICE_ROLE_KEY=
